# ─────────────────────────────────────────────────────────────────────────────
# Loki: PRODUCTION configuration template (docker-compose.yml)
#
#   cp .env.example .env     # then fill in every [required] value
#
# Local development uses .env.dev.example instead (see README). Full reference: docs/deployment.md.
# Legend:  [required] must be set   [optional] default shown, safe to delete
# Never commit .env. The backup service has its own file: backup.env (see backup.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────

# [required] Public https URL of the app, no trailing slash. Used for the OIDC redirect URI.
ORIGIN=https://loki.example.com

# ── Reverse proxy (Cloudflare Tunnel or nginx, see docs/deployment.md) ───────

# [required behind a proxy] Header carrying the original protocol; feeds SvelteKit's CSRF origin check.
PROTOCOL_HEADER=x-forwarded-proto
# [required behind a proxy] Header carrying the original host; feeds SvelteKit's CSRF origin check.
HOST_HEADER=x-forwarded-host
# [optional] Header carrying the client IP (rate limiting). Set only if a trusted proxy overwrites it.
ADDRESS_HEADER=x-forwarded-for

# ── Database ─────────────────────────────────────────────────────────────────

# [not used with docker-compose.yml] The compose file derives DATABASE_URL from POSTGRES_PASSWORD (below).
# Uncomment only when running the image against an external Postgres.
# DATABASE_URL=postgres://loki:<password>@<host>:5432/loki

# ── Storage: Cloudflare R2, EU jurisdiction (primary) ────────────────────────
# Create the bucket in the EU jurisdiction and keep it private (docs/deployment.md, "Cloudflare R2").
# Self-hosting instead? Use the commented `minio` block in docker-compose.yml, which lists the
# replacement values for this section.

# [required] EU endpoint of your account; note the ".eu." (EU buckets are unreachable via the default one).
S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# [required] Name of the private media bucket.
S3_BUCKET=loki
# [required] R2 API token key id (Object Read & Write, scoped to this bucket).
S3_ACCESS_KEY_ID=
# [required] R2 API token secret.
S3_SECRET_ACCESS_KEY=
# [optional] R2 always uses "auto".
S3_REGION=auto
# [optional] Path-style addressing: false for R2, true for MinIO.
S3_FORCE_PATH_STYLE=false

# ── OIDC (Authentik, see docs/deployment.md) ─────────────────────────────────

# [required] Issuer URL of the Authentik provider, with trailing slash.
OIDC_ISSUER=https://auth.example.com/application/o/loki/
# [required] Client id of the Authentik provider.
OIDC_CLIENT_ID=
# [required] Client secret of the Authentik provider (copy it from Authentik).
OIDC_CLIENT_SECRET=
# [optional] Name of the ID-token claim that carries the user's groups.
OIDC_GROUPS_CLAIM=groups
# [optional] Group granting the member role (may log in).
OIDC_GROUP_MEMBERS=loki-members
# [optional] Group granting the moderator role.
OIDC_GROUP_MODS=loki-mods
# [optional] Group granting the admin role.
OIDC_GROUP_ADMINS=loki-admins

# ── Limits ───────────────────────────────────────────────────────────────────

# [optional] Maximum upload size in megabytes.
MAX_UPLOAD_MB=50
# [optional] Net vote score at or below which a post is auto-blurred.
AUTO_BLUR_SCORE=-3
# [optional] Hard upper bound for a session's lifetime in days (the sliding 30-day renewal never exceeds it).
SESSION_ABSOLUTE_MAX_DAYS=90
# [optional, compose] Max request body size of adapter-node (its own default is 512K, too small for uploads).
# docker-compose.yml falls back to 60M. Keep it above MAX_UPLOAD_MB (bytes, or e.g. 60M) and match a
# reverse proxy's client_max_body_size, or uploads fail.
BODY_SIZE_LIMIT=60M

# ── Compose only (read by docker-compose.yml, not by the app) ────────────────

# [required] Password of the bundled Postgres; compose also builds DATABASE_URL from it.
# Generate with: openssl rand -hex 32   (hex keeps it URL-safe)
POSTGRES_PASSWORD=
# [required for the cloudflared sidecar only] Cloudflare Tunnel token (Zero Trust > Networks > Tunnels).
# TUNNEL_TOKEN=
# [required for the minio fallback only] Root credentials of the bundled MinIO; also use them as
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY. Generate with: openssl rand -hex 16 / openssl rand -hex 32
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
