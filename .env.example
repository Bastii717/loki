# Public origin of the app (used for OIDC redirects and CSRF checks)
ORIGIN=http://localhost:5173
# Secret used to sign session cookies; generate with `openssl rand -hex 32`
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# PostgreSQL connection string
DATABASE_URL=postgres://loki:loki@localhost:5432/loki
# S3-compatible endpoint (MinIO in dev, e.g. Cloudflare R2 in prod)
S3_ENDPOINT=http://localhost:9000
# Bucket that stores uploaded media
S3_BUCKET=loki
# S3 access key id
S3_ACCESS_KEY_ID=minioadmin
# S3 secret access key
S3_SECRET_ACCESS_KEY=minioadmin
# S3 region (R2 uses "auto")
S3_REGION=auto
# Path-style addressing: true for MinIO, false for Cloudflare R2
S3_FORCE_PATH_STYLE=true
# OIDC issuer URL (mock server in dev)
OIDC_ISSUER=http://localhost:8080/loki
# OIDC client id
OIDC_CLIENT_ID=loki
# OIDC client secret
OIDC_CLIENT_SECRET=dev-secret
# Name of the ID-token claim that carries the user's groups
OIDC_GROUPS_CLAIM=groups
# Group granting the member role
OIDC_GROUP_MEMBERS=loki-members
# Group granting the moderator role
OIDC_GROUP_MODS=loki-mods
# Group granting the admin role
OIDC_GROUP_ADMINS=loki-admins
# Maximum upload size in megabytes
MAX_UPLOAD_MB=50
# Net vote score at or below which a post is auto-blurred
AUTO_BLUR_SCORE=-3
# Hard upper bound for a session's lifetime in days (sliding 30-day renewal never exceeds it)
SESSION_ABSOLUTE_MAX_DAYS=90
# Deploy hint: adapter-node rejects request bodies above BODY_SIZE_LIMIT (default 512K).
# Set it at least to MAX_UPLOAD_MB (in bytes, or e.g. 60M) or uploads will fail.
# BODY_SIZE_LIMIT=60M
# Production only (adapter-node behind a reverse proxy / Cloudflare Tunnel, see docs/deployment.md):
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# compose.prod.yml only: password of the bundled Postgres (also used to build DATABASE_URL)
# POSTGRES_PASSWORD=change-me
# compose.prod.yml only: Cloudflare Tunnel token (cloudflared sidecar)
# TUNNEL_TOKEN=
# Backups (compose.prod.yml `backup` service, see backup/README.md). The media bucket is read via S3_*.
# Endpoint, bucket and credentials of the SEPARATE backup bucket (use different credentials than S3_*)
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=loki-backup
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# rclone crypt keys (generate with `openssl rand -base64 32`; losing them makes backups unreadable)
# BACKUP_CRYPT_PASSWORD=
# BACKUP_CRYPT_SALT=
# Cron schedule (container time zone, UTC unless TZ is set) and dump retention
# BACKUP_CRON=0 3 * * *
# BACKUP_RETENTION_DAYS=30
