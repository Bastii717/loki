# Environment of the `backup` service only (docker-compose.yml, env_file: backup.env). Never put these in .env:
# the app container reads .env and must not be able to reach the backup bucket or its crypt keys.

# Media bucket to back up (same bucket as the app's S3_BUCKET). Use a READ-ONLY token for it where the
# provider allows it (R2: "Object Read only", scoped to the media bucket), not the app's read/write token.
S3_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
S3_BUCKET=loki
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Separate backup bucket with its OWN credentials, scoped to that bucket only. The app's S3_* token must
# have no access to this bucket; ideally this token can write but not delete (see backup/README.md).
BACKUP_S3_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=loki-backup
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# rclone crypt keys (`openssl rand -base64 32` each). Keep a copy outside the server: without them the
# backups cannot be decrypted.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=

# Schedule (container time zone: UTC, or set TZ), retention, safety limits
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30
# a run that would delete more media objects than this from the mirror aborts
BACKUP_MAX_DELETE=200
# healthcheck: unhealthy if no backup succeeded within this many hours (2x the schedule interval)
BACKUP_MAX_AGE_HOURS=48
