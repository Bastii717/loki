# ─────────────────────────────────────────────────────────────────────────────
# Loki: BACKUP configuration template (docker-compose.yml: `backup` service)
#
#   cp backup.env.example backup.env && chmod 600 backup.env
#
# Read ONLY by the `backup` service (env_file: backup.env). Never put these values in .env:
# the app container reads .env and must not be able to reach the backup bucket or its crypt keys.
# Reference: docs/deployment.md and backup/README.md (incl. restore runbook).
# Legend:  [required] must be set   [optional] default shown, safe to delete
# ─────────────────────────────────────────────────────────────────────────────

# ── Source: media bucket (the app's bucket, Cloudflare R2 EU) ────────────────
# Use a READ-ONLY token where the provider allows it (R2: "Object Read only", scoped to the media
# bucket), not the app's read/write token.

# [required] EU endpoint of your account; note the ".eu.".
S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# [required] Same bucket as the app's S3_BUCKET.
S3_BUCKET=loki
# [required] Read-only R2 token key id.
S3_ACCESS_KEY_ID=
# [required] Read-only R2 token secret.
S3_SECRET_ACCESS_KEY=
# [optional] R2 always uses "auto".
S3_REGION=auto

# ── Target: backup bucket (Cloudflare R2 EU) ─────────────────────────────────
# A separate bucket with its OWN credentials, scoped to that bucket only. The app's S3_* token must
# have no access to it; ideally this token can write but not delete (see backup/README.md).

# [required] EU endpoint of your account; note the ".eu.".
BACKUP_S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# [required] Name of the backup bucket (EU jurisdiction, private).
BACKUP_S3_BUCKET=loki-backup
# [required] Backup-bucket token key id.
BACKUP_S3_ACCESS_KEY_ID=
# [required] Backup-bucket token secret.
BACKUP_S3_SECRET_ACCESS_KEY=
# [optional] R2 always uses "auto".
BACKUP_S3_REGION=auto

# ── Encryption (rclone crypt) ────────────────────────────────────────────────
# Keep a copy of both values outside the server (password manager): without them the backups
# cannot be decrypted.

# [required] Crypt password. Generate with: openssl rand -base64 32
BACKUP_CRYPT_PASSWORD=
# [required] Crypt salt. Generate with: openssl rand -base64 32
BACKUP_CRYPT_SALT=

# ── Schedule, retention, safety limits ───────────────────────────────────────

# [optional] Cron schedule (container time zone: UTC, or set TZ).
BACKUP_CRON=0 3 * * *
# [optional] Dumps and media-deleted/ folders older than this many days are removed.
BACKUP_RETENTION_DAYS=30
# [optional] A run that would delete more media objects than this from the mirror aborts.
BACKUP_MAX_DELETE=200
# [optional] Healthcheck turns unhealthy if no backup succeeded within this many hours (2x the schedule interval).
BACKUP_MAX_AGE_HOURS=48
