# ─────────────────────────────────────────────────────────────────────────────
# Loki: LOCAL DEVELOPMENT configuration template (docker-compose.dev.yml)
#
#   cp .env.dev.example .env
#
# Works with `npm run dev`, `npm test` and the scripts (`npx tsx --env-file=.env scripts/...`).
# Every value matches the stack in docker-compose.dev.yml; nothing here is a real secret.
# If Docker runs on a remote host, replace "localhost" in the endpoints below with that host.
# Production uses .env.example instead. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────

# Origin of the Vite dev server (port 5173); used for the OIDC redirect URI.
ORIGIN=http://localhost:5173

# ── Database (docker-compose.dev.yml: db) ────────────────────────────────────

# Postgres on port 5432, user/password/database all "loki".
DATABASE_URL=postgres://loki:loki@localhost:5432/loki

# ── Storage: MinIO (docker-compose.dev.yml: minio) ───────────────────────────
# Production uses Cloudflare R2 (EU) instead, see .env.example. The compose stack does not create
# the bucket: `npm test` does, otherwise create `loki` once (e.g. with `mc mb`).

# MinIO S3 API on port 9000 (the console is at http://localhost:9001).
S3_ENDPOINT=http://localhost:9000
# Media bucket (see note above).
S3_BUCKET=loki
# MinIO root user.
S3_ACCESS_KEY_ID=minioadmin
# MinIO root password.
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO ignores the region; "auto" keeps parity with R2.
S3_REGION=auto
# MinIO needs path-style addressing (R2 does not).
S3_FORCE_PATH_STYLE=true

# ── OIDC (docker-compose.dev.yml: oidc, mock server instead of Authentik) ────

# Issuer "loki" of the mock OAuth2 server on port 8080.
OIDC_ISSUER=http://localhost:8080/loki
# Any client id/secret is accepted by the mock server.
OIDC_CLIENT_ID=loki
OIDC_CLIENT_SECRET=dev-secret
# The mock server issues the "groups" claim with all three groups below (see JSON_CONFIG in the compose file).
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_MEMBERS=loki-members
OIDC_GROUP_MODS=loki-mods
OIDC_GROUP_ADMINS=loki-admins

# ── Limits ───────────────────────────────────────────────────────────────────

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=50
# Net vote score at or below which a post is auto-blurred.
AUTO_BLUR_SCORE=-3
# Hard upper bound for a session's lifetime in days.
SESSION_ABSOLUTE_MAX_DAYS=90
# Distinct reports on one item at which it is flagged for moderator review (integer >= 1).
REPORT_REVIEW_THRESHOLD=3

# ── Feedback mail (docker-compose.dev.yml: mailpit) ──────────────────────────
# Mailpit catches everything: SMTP on port 1025, inbox at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit speaks plain SMTP, so STARTTLS cannot be required here (production keeps the default, true).
SMTP_REQUIRE_TLS=false
MAIL_FROM=loki@example.test
FEEDBACK_TO=admin@example.test

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Not needed in development: the Vite dev server runs without a proxy, so PROTOCOL_HEADER,
# HOST_HEADER, ADDRESS_HEADER and BODY_SIZE_LIMIT stay unset (see .env.example for production).
